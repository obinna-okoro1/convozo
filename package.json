{
  "name": "convozo-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:all": "concurrently \"supabase functions serve\" \"ng serve\"",
    "build": "ng build",
    "db:types": "supabase gen types typescript --local --schema public > src/app/core/models/database.types.ts",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "depcruise:validate": "depcruise --config .dependency-cruiser.js src",
    "ci": "pnpm lint && pnpm depcruise:validate && pnpm test && pnpm build",
    "deploy": "./scripts/deploy-production.sh",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "e2e": "start-server-and-test start http://localhost:4200 cy:run",
    "e2e:ci": "start-server-and-test start http://localhost:4200 cy:run",
    "e2e:open": "start-server-and-test start http://localhost:4200 cy:open"
  },
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/cdk": "^21.1.0",
    "@daily-co/daily-js": "^0.89.0",
    "@supabase/supabase-js": "^2.95.3",
    "lodash-es": "^4.17.21",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.2.0",
    "@angular-eslint/eslint-plugin": "^21.2.0",
    "@angular-eslint/eslint-plugin-template": "^21.2.0",
    "@angular-eslint/schematics": "^21.2.0",
    "@angular-eslint/template-parser": "^21.2.0",
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "angular-eslint": "^21.2.0",
    "@analogjs/vite-plugin-angular": "^2.0.0",
    "@types/node": "^25.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "cypress": "^15.13.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.4.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-rxjs": "^5.0.3",
    "eslint-plugin-local-rules": "^3.0.0",
    "jsdom": "^27.1.0",
    "dependency-cruiser": "^17.3.2",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "start-server-and-test": "^3.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.0",
    "vitest": "^4.0.8",
    "web-push": "^3.6.7",
    "zone.js": "^0.16.1"
  }
}
